# PostgreSQL with TLS in production. Required for checkout, authentication, and admin features.
# The storefront can render its built-in fallback catalog when this is omitted.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/nirvana
# Required in production; generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
# Use demo only locally/staging. Production checkout requires zarinpal plus a valid merchant ID.
PAYMENT_MODE=demo
ZARINPAL_MERCHANT_ID=
# HTTPS endpoint receiving { type, to, name, resetUrl, expiresMinutes }
PASSWORD_RESET_WEBHOOK_URL=
# One-time bootstrap command reads these values
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Store Owner
